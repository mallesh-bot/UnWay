# Copy to .env.local and fill in from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Web Push public key (same as the VAPID_PUBLIC_KEY function secret)
VITE_VAPID_PUBLIC_KEY=
# Optional: Telegram bot username without @ (otherwise read from the server)
VITE_TELEGRAM_BOT=
# Optional: public address of this site if it differs from where it's opened (used in parent links)
VITE_PUBLIC_URL=
